text = "PICK A SONG"

[node name="Hint" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 28
text = "It loops forever, faster every time. Every loop gives a heart back; every 5th miss costs one."
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="Margin/Content"]
